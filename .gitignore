# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts

# Worker entry source.
!/build/
/build/*
!/build/worker.ts

/dist/
/.wrangler/
# Local tool state.
/.sites-runtime/
/.agents/
/outputs/
/work/

# Collection databases, interpreter and build caches
__pycache__/
*.pyc
*.sqlite
*.sqlite-*
*.tsbuildinfo
/lib/generated-product-photos.json

# Source/build archives
*.zip
